# Ключи API — файл-образец. Скопируйте его в secrets.yaml (тот уже в
# .gitignore и наружу не уйдёт) и впишите свои значения. Без ключей Джони
# не сломается: просто откатится на офлайн-голос (pyttsx3/edge) и claude -p.

groq_api_key: ""   # https://console.groq.com/keys — быстрые ответы Groq
fish_api_key: ""   # https://fish.audio — синтез голоса Джарвиса (клон голоса)

# «Доп мозг» — сильная модель для того, с чем не справился Groq. Ключа мало:
# какая из двух включена, решает `strong_brain` в settings.yaml (пусто =
# выключено). Разводить обязательно — за эти запросы платят по факту, и оплата
# ключа не должна сама по себе начинать их тратить.
#
# Нужен ровно ОДИН из двух, тот, что назван в strong_brain.
# Ключ от посредника (agentrouter.org и подобные) тоже подходит, но к нему
# обязателен адрес: strong_brain_base_url в settings.yaml. Без адреса запрос
# уйдёт на официальный сервер, где такой ключ неизвестен, — и ответом будет
# 401, а не «нет денег».
anthropic_api_key: ""   # https://console.anthropic.com — claude-opus-5 (pip install anthropic)
openai_api_key: ""      # https://platform.openai.com/api-keys — gpt-5.6-sol

# Внешние тулзы. Ключа мало: сами коннекторы включаются блоком connectors
# в settings.yaml. Ключ значит «могу», согласие — «разрешено», и разводить их
# обязательно: оплата ключа не должна сама по себе включать поиск по лицам.
#
# Azure AI Vision: «что на картинке» и OCR. Кроме ключа нужен АДРЕС ресурса —
# он у каждого свой и живёт в settings.yaml (connectors.azure-vision.endpoint),
# потому что адрес не секрет. Ключа без адреса не хватит.
azure_vision_key: ""      # https://portal.azure.com → Computer Vision → Keys and Endpoint

# Face++: сравнить два лица и разобрать лицо в кадре. Доступ — ПАРА, ключ и
# секрет отдельными строками в консоли; забывают обычно вторую.
# По интернету он не ищет (в отличие от прежнего FaceCheck), но лицо всё равно
# уезжает третьей стороне — поэтому и согласие, и журнал доступа.
faceplusplus_api_key: ""     # https://console.faceplusplus.com/app/apikey/list
faceplusplus_api_secret: ""  # там же, вторая строка того же ключа

# Перевод работает офлайн (pip install argostranslate) и ключа не требует.
# Этот нужен только чужому инстансу LibreTranslate, который просит ключ.
libretranslate_api_key: ""

# Свой сервис синтеза (XTTS v2; NeMo снят с плана 2026-08-08). Пустая строка =
# ходим без авторизации, и это нормально, пока сервис слушает только localhost.
# Как только он выставлен наружу — токен обязателен, иначе GPU-эндпоинт открыт
# всему интернету.
tts_local_token: ""
